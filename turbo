#!/usr/bin/env bash
set -euo pipefail

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_STEP=$'\033[1;36m'
    C_ERR=$'\033[0;31m'
    C_WARN=$'\033[0;33m'
    C_OK=$'\033[0;32m'
    C_PURPLE=$'\033[38;5;183m'
    C_RESET=$'\033[0m'
else
    C_STEP='' C_ERR='' C_WARN='' C_OK='' C_PURPLE='' C_RESET=''
fi

TURBO_VERSION="1.1.1"

TURBO_CONFIG_FILE="${TURBO_CONFIG_FILE:-$HOME/.config/turbo/config}"
TURBO_DEFAULT_PROJECTS_DIR="${TURBO_DEFAULT_PROJECTS_DIR:-/home/jack/PhpstormProjects}"
TURBO_REPO_URL="${TURBO_REPO_URL:-https://github.com/jackelvinsson/turbo}"
TURBO_REPO_BRANCH="${TURBO_REPO_BRANCH:-master}"
TURBO_VERSION_FILE="${TURBO_VERSION_FILE:-$HOME/.local/share/turbo/version}"
TURBO_TEMPLATE_REPO="${TURBO_TEMPLATE_REPO:-jackelvinsson/laravel-template-vue}"
TURBO_TEMPLATE_CLONE_URL="${TURBO_TEMPLATE_CLONE_URL:-https://github.com/jackelvinsson/laravel-template-vue.git}"
TURBO_INSTALL_URL="${TURBO_INSTALL_URL:-https://raw.githubusercontent.com/jackelvinsson/turbo/master/install.sh}"
TURBO_INSTALL_BIN_DIR="${TURBO_INSTALL_BIN_DIR:-$HOME/.local/bin}"

print_banner() {
    local l1=' ______   __  __     ______     ______     ______'
    local l2='/\__  _\ /\ \/\ \   /\  == \   /\  == \   /\  __ \'
    local l3='\/_/\ \/ \ \ \_\ \  \ \  __<   \ \  __<   \ \ \/\ \'
    local l4='   \ \_\  \ \_____\  \ \_\ \_\  \ \_____\  \ \_____\'
    local l5='    \/_/   \/_____/   \/_/ /_/   \/_____/   \/_____/'

    echo "${C_STEP}${l1}${C_RESET}"
    echo "${C_STEP}${l2}${C_RESET}"
    echo "${C_STEP}${l3}${C_RESET}"
    echo "${C_STEP}${l4}${C_RESET}"
    echo "${C_STEP}${l5} ${C_PURPLE}v${TURBO_VERSION}${C_RESET}"
    echo "${C_STEP}    Scaffold Laravel projects, fast.${C_RESET}"
    echo ""
}

usage() {
    print_banner
    cat <<'EOF'
Usage: turbo <command>

Commands:
  create          Interactively scaffold a new project from laravel-template-vue
  destroy <name>  Delete a project's local directory and, optionally, its GitHub repo
  update          Update turbo to the latest version
  help            Show this help message
EOF
}

slugify() {
    local input="$1"
    printf '%s' "$input" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

validate_project_name() {
    local input="$1"
    [[ -n "$input" && "$input" =~ ^[A-Za-z0-9\ ]+$ ]]
}

read_projects_dir() {
    if [ -f "$TURBO_CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$TURBO_CONFIG_FILE"
    fi
    printf '%s' "${PROJECTS_DIR:-$TURBO_DEFAULT_PROJECTS_DIR}"
}

check_for_update() {
    local remote_hash local_hash
    remote_hash="$(git ls-remote "$TURBO_REPO_URL" "$TURBO_REPO_BRANCH" 2>/dev/null | cut -f1)" || true

    if [ -z "$remote_hash" ]; then
        return 0
    fi

    local_hash=""
    if [ -f "$TURBO_VERSION_FILE" ]; then
        local_hash="$(cat "$TURBO_VERSION_FILE")"
    fi

    if [ "$remote_hash" = "$local_hash" ]; then
        return 0
    fi

    echo "${C_WARN}A new version of turbo is available.${C_RESET}"
    read -r -p "Update now? [Y/n] " reply
    case "$reply" in
        [nN]*)
            return 0
            ;;
        *)
            TURBO_SKIP_SUCCESS_MSG=1 cmd_update
            exec "$0" create
            ;;
    esac
}

preflight() {
    local missing=()
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v curl >/dev/null 2>&1 || missing+=("curl")

    if [ "${#missing[@]}" -gt 0 ]; then
        echo "${C_ERR}Missing required tool(s): ${missing[*]}${C_RESET}" >&2
        exit 1
    fi
}

create_github_repo() {
    local slug="$1" projects_dir="$2"

    if ! command -v gh >/dev/null 2>&1; then
        echo "${C_ERR}Error: gh is not installed. Install it, then run 'gh auth login'.${C_RESET}" >&2
        exit 1
    fi

    if ! gh auth status >/dev/null 2>&1; then
        echo "${C_ERR}Error: gh is not authenticated. Run 'gh auth login' and try again.${C_RESET}" >&2
        exit 1
    fi

    local visibility
    read -e -i "private" -p "Private or public? " visibility
    visibility="${visibility:-private}"
    case "$visibility" in
        [pP][uU]*) visibility="public" ;;
        *) visibility="private" ;;
    esac

    echo ""
    echo "${C_STEP}==> Creating ${C_PURPLE}${visibility}${C_STEP} GitHub repository${C_RESET}"
    (cd "$projects_dir" && gh repo create "$slug" --template "$TURBO_TEMPLATE_REPO" "--$visibility" --clone)
}

cmd_create() {
    check_for_update
    print_banner
    preflight

    local projects_dir
    projects_dir="$(read_projects_dir)"
    mkdir -p "$projects_dir"

    local name
    while true; do
        read -r -p "Project name: " name
        if validate_project_name "$name"; then
            break
        fi
        echo "${C_ERR}Project name must contain only letters, numbers, and spaces.${C_RESET}" >&2
    done

    local slug
    slug="$(slugify "$name")"

    local target_dir="$projects_dir/$slug"
    if [ -e "$target_dir" ]; then
        echo "${C_ERR}Error: $target_dir already exists.${C_RESET}" >&2
        exit 1
    fi

    local create_repo
    read -r -p "Create a GitHub repo for this? [Y/n] " create_repo
    case "$create_repo" in
        [nN]*)
            echo ""
            echo "${C_STEP}==> Cloning ${C_PURPLE}laravel-template-vue${C_STEP}${C_RESET}"
            git clone --progress "$TURBO_TEMPLATE_CLONE_URL" "$target_dir"
            ;;
        *)
            create_github_repo "$slug" "$projects_dir"
            ;;
    esac

    echo ""
    echo "${C_OK}Project ready at ${C_PURPLE}${target_dir}${C_RESET}"
    echo ""

    local run_setup
    read -r -p "Run project setup now? [Y/n] " run_setup
    case "$run_setup" in
        [nN]*)
            echo ""
            echo "When you're ready, run:"
            echo "  cd ${C_PURPLE}${target_dir}${C_RESET}"
            echo "  ./setup.sh \"$name\""
            ;;
        *)
            echo ""
            echo "${C_STEP}==> Running project setup${C_RESET}"
            (cd "$target_dir" && ./setup.sh "$name")
            ;;
    esac
    echo ""
}

cmd_update() {
    echo ""
    echo "${C_STEP}==> Updating turbo${C_RESET}"
    curl -fsSL "$TURBO_INSTALL_URL" | bash
}

cmd_destroy() {
    local input="${1:-}"
    if [ -z "$input" ]; then
        echo "${C_ERR}Usage: turbo destroy <project>${C_RESET}" >&2
        exit 1
    fi

    local slug
    slug="$(slugify "$input")"

    local projects_dir
    projects_dir="$(read_projects_dir)"
    local target_dir="$projects_dir/$slug"

    if [ ! -d "$target_dir" ]; then
        echo "${C_ERR}Error: $target_dir does not exist.${C_RESET}" >&2
        exit 1
    fi

    local remote_repo=""
    if [ -d "$target_dir/.git" ]; then
        local remote_url
        remote_url="$(git -C "$target_dir" remote get-url origin 2>/dev/null)" || true
        case "$remote_url" in
            *github.com*)
                remote_repo="$(printf '%s' "$remote_url" | sed -E 's#.*github\.com[:/]##; s#\.git$##')"
                ;;
        esac

        # A project cloned via the "local clone, no GitHub repo" path in
        # cmd_create has origin pointing at the template itself, not a repo
        # created for this project. Never treat that as this project's repo.
        if [ "$remote_repo" = "$TURBO_TEMPLATE_REPO" ]; then
            remote_repo=""
        fi
    fi

    echo "${C_WARN}This will permanently delete:${C_RESET}"
    echo "  ${C_PURPLE}${target_dir}${C_RESET}"
    if [ -n "$remote_repo" ]; then
        echo "  ${C_PURPLE}github.com/${remote_repo}${C_RESET} (only if you confirm separately below)"
    fi
    echo ""

    local confirm
    read -r -p "Type the project name to confirm: " confirm
    if [ "$confirm" != "$input" ]; then
        echo "${C_ERR}Confirmation did not match, aborting.${C_RESET}" >&2
        exit 1
    fi

    if [ -n "$remote_repo" ]; then
        local delete_repo
        read -r -p "Also delete the GitHub repo $remote_repo? [y/N] " delete_repo
        case "$delete_repo" in
            [yY]*)
                local gh_error=""
                if ! command -v gh >/dev/null 2>&1; then
                    gh_error="gh is not installed."
                elif ! gh auth status >/dev/null 2>&1; then
                    gh_error="gh is not authenticated. Run 'gh auth login' and try again."
                fi

                if [ -n "$gh_error" ]; then
                    echo ""
                    echo "${C_ERR}Error: $gh_error Cannot delete the GitHub repo.${C_RESET}" >&2
                    local continue_local
                    read -r -p "Still delete the local project? [Y/n] " continue_local
                    case "$continue_local" in
                        [nN]*)
                            echo ""
                            echo "Aborted, nothing was deleted."
                            exit 0
                            ;;
                    esac
                else
                    echo ""
                    echo "${C_STEP}==> Deleting GitHub repo ${C_PURPLE}${remote_repo}${C_STEP}${C_RESET}"
                    if ! gh repo delete "$remote_repo" --yes; then
                        echo ""
                        echo "${C_ERR}Error: failed to delete the GitHub repo.${C_RESET}" >&2
                        local continue_local
                        read -r -p "Still delete the local project? [Y/n] " continue_local
                        case "$continue_local" in
                            [nN]*)
                                echo ""
                                echo "Aborted, nothing further was deleted."
                                exit 0
                                ;;
                        esac
                    fi
                fi
                ;;
        esac
    fi

    echo ""
    echo "${C_STEP}==> Deleting ${C_PURPLE}${target_dir}${C_RESET}"
    rm -rf "$target_dir"
    echo "${C_OK}Destroyed $input${C_RESET}"
    echo ""
}

cmd_dev() {
    local source_path
    source_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

    if [ "$source_path" = "$TURBO_INSTALL_BIN_DIR/turbo" ]; then
        echo "${C_ERR}Already running from $TURBO_INSTALL_BIN_DIR/turbo, run this from your local clone instead.${C_RESET}" >&2
        exit 1
    fi

    echo ""
    echo "${C_STEP}==> Installing local copy for testing${C_RESET}"
    mkdir -p "$TURBO_INSTALL_BIN_DIR"
    cp "$source_path" "$TURBO_INSTALL_BIN_DIR/turbo"
    chmod +x "$TURBO_INSTALL_BIN_DIR/turbo"
    echo "${C_OK}Installed ${C_PURPLE}${source_path}${C_OK} to ${C_PURPLE}${TURBO_INSTALL_BIN_DIR}/turbo${C_RESET}"
    echo ""
}

main() {
    local cmd="${1:-help}"
    case "$cmd" in
        create) cmd_create ;;
        destroy) cmd_destroy "${2:-}" ;;
        update) cmd_update ;;
        dev) cmd_dev ;;
        help|-h|--help) usage ;;
        *)
            usage
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
