#!/usr/bin/env bash
set -euo pipefail

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_STEP=$'\033[1;36m'
    C_ERR=$'\033[0;31m'
    C_WARN=$'\033[0;33m'
    C_OK=$'\033[0;32m'
    C_RESET=$'\033[0m'
else
    C_STEP='' C_ERR='' C_WARN='' C_OK='' C_RESET=''
fi

TURBO_CONFIG_FILE="${TURBO_CONFIG_FILE:-$HOME/.config/turbo/config}"
TURBO_DEFAULT_PROJECTS_DIR="${TURBO_DEFAULT_PROJECTS_DIR:-/home/jack/PhpstormProjects}"
TURBO_REPO_URL="${TURBO_REPO_URL:-https://github.com/jackelvinsson/turbo}"
TURBO_REPO_BRANCH="${TURBO_REPO_BRANCH:-master}"
TURBO_VERSION_FILE="${TURBO_VERSION_FILE:-$HOME/.local/share/turbo/version}"
TURBO_TEMPLATE_REPO="${TURBO_TEMPLATE_REPO:-jackelvinsson/laravel-template}"
TURBO_TEMPLATE_CLONE_URL="${TURBO_TEMPLATE_CLONE_URL:-https://github.com/jackelvinsson/laravel-template.git}"
TURBO_INSTALL_URL="${TURBO_INSTALL_URL:-https://raw.githubusercontent.com/jackelvinsson/turbo/master/install.sh}"

usage() {
    cat <<'EOF'
Usage: turbo <command>

Commands:
  create    Interactively scaffold a new project from laravel-template
  update    Update turbo to the latest version
  help      Show this help message
EOF
}

slugify() {
    local input="$1"
    printf '%s' "$input" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

validate_project_name() {
    local input="$1"
    [[ -n "$input" && "$input" =~ ^[A-Za-z0-9\ ]+$ ]]
}

read_projects_dir() {
    if [ -f "$TURBO_CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$TURBO_CONFIG_FILE"
    fi
    printf '%s' "${PROJECTS_DIR:-$TURBO_DEFAULT_PROJECTS_DIR}"
}

check_for_update() {
    local remote_hash local_hash
    remote_hash="$(git ls-remote "$TURBO_REPO_URL" "$TURBO_REPO_BRANCH" 2>/dev/null | cut -f1)" || true

    if [ -z "$remote_hash" ]; then
        return 0
    fi

    local_hash=""
    if [ -f "$TURBO_VERSION_FILE" ]; then
        local_hash="$(cat "$TURBO_VERSION_FILE")"
    fi

    if [ "$remote_hash" = "$local_hash" ]; then
        return 0
    fi

    echo "${C_WARN}A new version of turbo is available. Run 'turbo update' to update.${C_RESET}"
    read -r -p "Continue anyway? [Y/n] " reply
    case "$reply" in
        [nN]*)
            echo "Run 'turbo update' when you're ready."
            exit 0
            ;;
    esac
}

preflight() {
    local missing=()
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v curl >/dev/null 2>&1 || missing+=("curl")

    if [ "${#missing[@]}" -gt 0 ]; then
        echo "${C_ERR}Missing required tool(s): ${missing[*]}${C_RESET}" >&2
        exit 1
    fi
}

create_github_repo() {
    local slug="$1" projects_dir="$2"

    if ! command -v gh >/dev/null 2>&1; then
        echo "${C_ERR}Error: gh is not installed. Install it, then run 'gh auth login'.${C_RESET}" >&2
        exit 1
    fi

    if ! gh auth status >/dev/null 2>&1; then
        echo "${C_ERR}Error: gh is not authenticated. Run 'gh auth login' and try again.${C_RESET}" >&2
        exit 1
    fi

    local visibility
    read -e -i "private" -p "Private or public? " visibility
    visibility="${visibility:-private}"
    case "$visibility" in
        [pP]*) visibility="public" ;;
        *) visibility="private" ;;
    esac

    (cd "$projects_dir" && gh repo create "$slug" --template "$TURBO_TEMPLATE_REPO" "--$visibility" --clone)
}

cmd_create() {
    check_for_update
    preflight

    local projects_dir
    projects_dir="$(read_projects_dir)"
    mkdir -p "$projects_dir"

    local name
    while true; do
        read -r -p "Project name: " name
        if validate_project_name "$name"; then
            break
        fi
        echo "${C_ERR}Project name must contain only letters, numbers, and spaces.${C_RESET}" >&2
    done

    local slug
    slug="$(slugify "$name")"

    local target_dir="$projects_dir/$slug"
    if [ -e "$target_dir" ]; then
        echo "${C_ERR}Error: $target_dir already exists.${C_RESET}" >&2
        exit 1
    fi

    local create_repo
    read -r -p "Create a GitHub repo for this? [Y/n] " create_repo
    case "$create_repo" in
        [nN]*)
            git clone --progress "$TURBO_TEMPLATE_CLONE_URL" "$target_dir"
            ;;
        *)
            create_github_repo "$slug" "$projects_dir"
            ;;
    esac

    local run_setup
    read -r -p "Cloning complete. Run project setup now? [Y/n] " run_setup
    case "$run_setup" in
        [nN]*)
            echo "When you're ready, run:"
            echo "  cd $target_dir"
            echo "  ./setup.sh \"$name\""
            ;;
        *)
            (cd "$target_dir" && ./setup.sh "$name")
            ;;
    esac
}

cmd_update() {
    echo "${C_STEP}==> Updating turbo${C_RESET}"
    curl -fsSL "$TURBO_INSTALL_URL" | bash
}

main() {
    local cmd="${1:-help}"
    case "$cmd" in
        create) cmd_create ;;
        update) cmd_update ;;
        help|-h|--help) usage ;;
        *)
            usage
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
