#!/usr/bin/env bash
set -euo pipefail

TURBO_CONFIG_FILE="${TURBO_CONFIG_FILE:-$HOME/.config/turbo/config}"
TURBO_DEFAULT_PROJECTS_DIR="${TURBO_DEFAULT_PROJECTS_DIR:-/home/jack/PhpstormProjects}"

usage() {
    cat <<'EOF'
Usage: turbo <command>

Commands:
  create    Interactively scaffold a new project from laravel-template
  update    Update turbo to the latest version
  help      Show this help message
EOF
}

slugify() {
    local input="$1"
    printf '%s' "$input" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

validate_project_name() {
    local input="$1"
    [[ -n "$input" && "$input" =~ ^[A-Za-z0-9\ ]+$ ]]
}

read_projects_dir() {
    if [ -f "$TURBO_CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$TURBO_CONFIG_FILE"
    fi
    printf '%s' "${PROJECTS_DIR:-$TURBO_DEFAULT_PROJECTS_DIR}"
}

main() {
    local cmd="${1:-help}"
    case "$cmd" in
        create) cmd_create ;;
        update) cmd_update ;;
        help|-h|--help) usage ;;
        *)
            usage
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
